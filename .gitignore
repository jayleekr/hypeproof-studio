# Build artifacts & downloaded sources (regenerated by build pipeline)
vscodium-base/vscode/
vscodium-base/VSCode-*/
vscodium-base/VSCodium-*/

# Node
**/node_modules/
**/dist/

# Logs / local state
logs/
*.log

# OS
.DS_Store

# Env / secrets (use hypeproof-studio.env.example as template)
hypeproof-studio.env
.env
.env.*
!.env.example

# Editor
.vscode/
.idea/

# Git worktree checkouts (e.g. .claude/worktrees/ux) — separate working trees
# of this same repo; never track them on main. Skills/rules under .claude/
# stay tracked.
.claude/worktrees/

# Python cache
**/__pycache__/
*.pyc

# TS build artifacts (alongside .ts sources)
extensions/hypeproof-chat/src/*.js
extensions/hypeproof-chat/webview-ui/src/*.js
**/*.tsbuildinfo

# Worker (Cloudflare Wrangler local state)
**/.wrangler/
**/.dev.vars
.dev.vars
