{
  "name": "hypeproof-chat",
  "displayName": "HypeProof Chat",
  "description": "Built-in chat panel for HypeProof Studio.",
  "version": "0.1.5",
  "publisher": "hypeproof",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hypeproof-chat",
          "title": "HypeProof Chat",
          "icon": "media/chat.svg"
        }
      ]
    },
    "views": {
      "hypeproof-chat": [
        {
          "id": "hypeproof-chat.panel",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "hypeproof-chat.focus",
        "title": "HypeProof Chat: Focus"
      },
      {
        "command": "hypeproof-chat.clearHistory",
        "title": "HypeProof Chat: Clear Conversation"
      },
      {
        "command": "hypeproof-chat.setToken",
        "title": "HypeProof Chat: Set Workshop Token"
      },
      {
        "command": "hypeproof-chat.runLastCode",
        "title": "HypeProof Chat: Run Last Code in Preview"
      },
      {
        "command": "hypeproof-chat.renameCoach",
        "title": "HypeProof Chat: 코치 이름 다시 짓기"
      },
      {
        "command": "hypeproof-chat.reportProblem",
        "title": "HypeProof Chat: 문제 신고하기"
      },
      {
        "command": "hypeproof-chat.checkForUpdates",
        "title": "HypeProof Chat: 업데이트 확인"
      },
      {
        "command": "hypeproof-chat.installUpdate",
        "title": "HypeProof Chat: 업데이트 설치"
      },
      {
        "command": "hypeproof-chat.mintStudentToken",
        "title": "HypeProof Chat: 학생 토큰 발급 (강사용)"
      },
      {
        "command": "hypeproof-chat.forgetIssuerToken",
        "title": "HypeProof Chat: 저장된 issuer 토큰 지우기"
      },
      {
        "command": "hypeproof-chat.previewActiveFile",
        "title": "HypeProof: HTML 미리보기 (옆 패널)",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "hypeproof-chat.previewActiveFile",
          "when": "resourceExtname == .html || resourceExtname == .htm",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "hypeproof-chat.previewActiveFile",
          "when": "resourceExtname == .html || resourceExtname == .htm",
          "group": "navigation@5"
        }
      ]
    },
    "configuration": {
      "title": "HypeProof Chat",
      "properties": {
        "hypeproofChat.proxyUrl": {
          "type": "string",
          "default": "https://api.hypeproof-ai.xyz/v1",
          "description": "Base URL for the HypeProof Proxy (OpenAI-compatible). Override for local dev (e.g. http://localhost:8787/v1)."
        },
        "hypeproofChat.model": {
          "type": "string",
          "default": "hypeproof-default",
          "description": "Model identifier sent to the proxy."
        },
        "hypeproofChat.requireApprovalFor": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "writeFile",
              "executeShell"
            ]
          },
          "default": [
            "writeFile",
            "executeShell"
          ],
          "description": "Actions that require explicit user approval before execution."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build:webview && npm run build:extension",
    "build:extension": "esbuild src/extension.ts --bundle --platform=node --target=node18 --external:vscode --outfile=dist/extension.js",
    "build:webview": "cd webview-ui && npm install && npm run build",
    "typecheck": "tsc --noEmit",
    "watch:extension": "esbuild src/extension.ts --bundle --platform=node --target=node18 --external:vscode --outfile=dist/extension.js --watch",
    "watch:webview": "cd webview-ui && npm run dev",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.4.0"
  }
}
