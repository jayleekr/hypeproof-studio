{
  "name": "hypeproof-chat",
  "displayName": "HypeProof Chat",
  "description": "Built-in chat panel for HypeProof Studio.",
  "version": "0.1.5",
  "publisher": "hypeproof",
  "engines": {
    "vscode": "^1.116.0"
  },
  "enabledApiProposals": [
    "browser"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The coach can run shell commands and resolve an SDK executable. In an untrusted workspace, the runtime/executable and gateway settings are ignored and every action still passes through the approval gate.",
      "restrictedConfigurations": [
        "hypeproofChat.sdkBinaryPath",
        "hypeproofChat.coachRuntime",
        "hypeproofChat.proxyUrl",
        "hypeproofChat.requireApprovalFor"
      ]
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hypeproof-chat",
          "title": "HypeProof Chat",
          "icon": "media/chat.svg"
        }
      ]
    },
    "views": {
      "hypeproof-chat": [
        {
          "id": "hypeproof-chat.panel",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "hypeproof-chat.focus",
        "title": "HypeProof Chat: Focus"
      },
      {
        "command": "hypeproof-chat.openBrowser",
        "title": "HypeProof: 브라우저 열기",
        "icon": "$(globe)"
      },
      {
        "command": "hypeproof-chat.sendPageToCoach",
        "title": "HypeProof: 현재 페이지를 코치에게 보내기",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "hypeproof-chat.clearHistory",
        "title": "HypeProof Chat: Clear Conversation"
      },
      {
        "command": "hypeproof-chat.setToken",
        "title": "HypeProof Chat: Set Workshop Token"
      },
      {
        "command": "hypeproof-chat.runLastCode",
        "title": "HypeProof Chat: Run Last Code in Preview"
      },
      {
        "command": "hypeproof-chat.renameCoach",
        "title": "HypeProof Chat: 코치 이름 다시 짓기"
      },
      {
        "command": "hypeproof-chat.reportProblem",
        "title": "HypeProof Chat: 문제 신고하기"
      },
      {
        "command": "hypeproof-chat.checkForUpdates",
        "title": "HypeProof Chat: 업데이트 확인"
      },
      {
        "command": "hypeproof-chat.installUpdate",
        "title": "HypeProof Chat: 업데이트 설치"
      },
      {
        "command": "hypeproof-chat.mintStudentToken",
        "title": "HypeProof Chat: 학생 토큰 발급 (강사용)"
      },
      {
        "command": "hypeproof-chat.forgetIssuerToken",
        "title": "HypeProof Chat: 저장된 issuer 토큰 지우기"
      },
      {
        "command": "hypeproof-chat.previewActiveFile",
        "title": "HypeProof: HTML 미리보기 (옆 패널)",
        "icon": "$(open-preview)"
      },
      {
        "command": "hypeproof-chat.uploadSessionLogs",
        "title": "HypeProof: 오늘 활동 기록 보내기"
      },
      {
        "command": "hypeproof-chat.previewViewport",
        "title": "HypeProof: 미리보기 화면 크기",
        "icon": "$(device-mobile)"
      },
      {
        "command": "hypeproof-chat.start",
        "title": "HypeProof: 시작 화면",
        "icon": "$(home)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "hypeproof-chat.openBrowser",
          "when": "view == hypeproof-chat.panel",
          "group": "navigation@1"
        },
        {
          "command": "hypeproof-chat.sendPageToCoach",
          "when": "view == hypeproof-chat.panel && hypeproof-chat.pageContextEnabled",
          "group": "navigation@2"
        },
        {
          "command": "hypeproof-chat.previewViewport",
          "when": "view == hypeproof-chat.panel",
          "group": "navigation@3"
        }
      ],
      "editor/title": [
        {
          "command": "hypeproof-chat.previewActiveFile",
          "when": "resourceExtname == .html || resourceExtname == .htm",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "hypeproof-chat.previewActiveFile",
          "when": "resourceExtname == .html || resourceExtname == .htm",
          "group": "navigation@5"
        }
      ]
    },
    "configuration": {
      "title": "HypeProof Chat",
      "properties": {
        "hypeproofChat.proxyUrl": {
          "type": "string",
          "default": "https://api.hypeproof-ai.xyz/v1",
          "scope": "machine",
          "description": "Base URL for the HypeProof Proxy (OpenAI-compatible). Override for local dev (e.g. http://localhost:8787/v1). Machine-scoped: a workspace cannot repoint the coach at an untrusted gateway."
        },
        "hypeproofChat.model": {
          "type": "string",
          "default": "hypeproof-default",
          "description": "Model identifier sent to the proxy."
        },
        "hypeproofChat.coachRuntime": {
          "type": "string",
          "enum": [
            "proxy",
            "agent-sdk"
          ],
          "default": "proxy",
          "scope": "machine",
          "description": "Coach runtime. 'proxy' = the current single-turn provider proxy (default). 'agent-sdk' = the Claude Agent SDK coach (epic #282). Until the SDK is bundled (Phase 1), selecting 'agent-sdk' transparently falls back to the proxy runtime for each turn (a dev warning is logged); it never interrupts the student. Machine-scoped: a workspace cannot flip the runtime to the SDK executable path."
        },
        "hypeproofChat.sdkBinaryPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to a claude CLI binary for the agent-sdk coach runtime (epic #282). Highest-priority override; when empty, resolution falls through HPS_SDK_BINARY (env) → the seeded per-user location (scripts/seed-sdk-binary.sh) → node_modules (dev). If nothing resolves, the coach falls back to the proxy runtime. Machine-scoped: this selects an executable, so a workspace must not be able to set it."
        },
        "hypeproofChat.sdkStallTimeoutMs": {
          "type": "number",
          "default": 240000,
          "minimum": 0,
          "scope": "machine",
          "description": "How long (ms) the agent-sdk coach may go without progress before the turn is aborted with a friendly retry message (#403). Guards the cases the 401/400 fast-fail does not cover — gateway 429/529/5xx retry storms, or a first turn that never produces a token — which otherwise leave the student on \"생각하는 중…\" forever. 0 disables the watchdog."
        },
        "hypeproofChat.requireApprovalFor": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "writeFile",
              "executeShell",
              "openBrowser",
              "delegateAgent",
              "browserType"
            ]
          },
          "default": [
            "executeShell",
            "openBrowser",
            "delegateAgent",
            "browserType"
          ],
          "scope": "machine",
          "description": "Actions that require explicit user approval before execution. 이 배열이 승인 정책의 단일 소스다 — 코드의 getConfiguration 폴백은 매니페스트 default 가 있는 한 절대 쓰이지 않는다(#499). writeFile 은 기본에서 제외(#464): 워크스페이스 밖 경로는 모달 없이 이미 거부되고, 실측에서 이 모달이 세션을 멈추거나 반사 승인을 훈련시켰다. 되돌리려면 \"writeFile\" 을 추가한다. Machine-scoped: a workspace cannot weaken the approval gate (e.g. clear it to auto-run shell/file writes)."
        },
        "hypeproofChat.siteBase": {
          "type": "string",
          "default": "https://hypeproof-ai.xyz",
          "description": "HypeProof Lab 사이트 주소. '갤러리에 올리기'가 여기로 보냅니다. 로컬 개발 서버에 붙여 볼 때만 바꾸세요 (예: http://localhost:3000)."
        }
      }
    },
    "themes": [
      {
        "label": "HypeProof Studio",
        "uiTheme": "vs-dark",
        "path": "./media/hypeproof-theme.json"
      }
    ],
    "configurationDefaults": {
      "workbench.colorTheme": "HypeProof Studio",
      "workbench.activityBar.location": "hidden",
      "window.commandCenter": false,
      "workbench.layoutControl.enabled": false,
      "workbench.statusBar.visible": false,
      "workbench.editor.showIcons": false,
      "workbench.editor.editorActionsLocation": "hidden",
      "workbench.tips.enabled": false
    }
  },
  "scripts": {
    "build": "npm run build:webview && npm run build:extension",
    "build:extension": "esbuild src/extension.ts --bundle --platform=node --target=node18 --external:vscode --outfile=dist/extension.js",
    "build:webview": "cd webview-ui && npm install && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "for f in test/*.smoke.mjs; do echo \"— $f\"; node --experimental-strip-types \"$f\" || exit 1; done",
    "watch:extension": "esbuild src/extension.ts --bundle --platform=node --target=node18 --external:vscode --outfile=dist/extension.js --watch",
    "watch:webview": "cd webview-ui && npm run dev",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.207",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.4.0"
  }
}
