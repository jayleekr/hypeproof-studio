# worker/.dev.vars — local secrets for `wrangler dev`. Copy to `.dev.vars`
# and fill in. THIS FILE (.example) is committed; `.dev.vars` is gitignored.
#
# Fastest path: from the repo root run `bash scripts/dev-secrets.sh`
# (pulls GEMINI_KEY from your ~/.env into worker/.dev.vars automatically).

# LLM provider keys. The provider is switchable via LLM_PROVIDER (below).
# Gemini is the default model for workshop runs. Get a key:
#   Gemini    → https://aistudio.google.com/apikey
#   Anthropic → https://console.anthropic.com/settings/keys
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# HMAC secret used to sign/verify workshop tokens. Any long random string;
# must match whatever issued the tokens you test with.
HPS_SIGNING_SECRET=

# Admin panel password (only needed if you exercise /admin routes locally).
HPS_ADMIN_PASSWORD=

# Switchable provider. Defaults to "gemini" when GEMINI_API_KEY is set.
# Developing through Claude Code? Set this to "anthropic" (with
# ANTHROPIC_API_KEY above) — it's a peer, not a fallback. One line, no code.
# LLM_PROVIDER=gemini
