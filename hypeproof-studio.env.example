# HypeProof Studio build environment overrides
# Source this BEFORE running prepare_vscode.sh / build.sh:
#   source ../hypeproof-studio.env   (from inside vscodium-base/)
#
# These override the VSCodium-flavored defaults in vscodium-base/utils.sh.

# --- Identity -----------------------------------------------------------------
export APP_NAME="HypeProof Studio"
export APP_NAME_LC="hypeproof-studio"
export BINARY_NAME="hypeproof-studio"
export ORG_NAME="HypeProof Lab"

# GitHub repo paths (used by release scripts; safe defaults for solo build)
export ASSETS_REPOSITORY="jayleekr/hypeproof-studio"
export GH_REPO_PATH="jayleekr/hypeproof-studio"

# --- product.json overrides (consumed by prepare_vscode.sh jq block) ----------
# See scripts/apply-product-overrides.sh for the actual jq invocation.
export HPS_NAME_SHORT="HypeProof Studio"
export HPS_NAME_LONG="HypeProof Studio"
export HPS_APPLICATION_NAME="hypeproof-studio"
export HPS_DATA_FOLDER_NAME=".hypeproof-studio"
export HPS_DARWIN_BUNDLE_ID="ai.hypeproof.studio"
export HPS_URL_PROTOCOL="hypeproof-studio"
export HPS_WIN32_DIR_NAME="HypeProof Studio"
export HPS_WIN32_NAME_VERSION="HypeProof Studio"
export HPS_WIN32_MUTEX_NAME="hypeproofstudio"
export HPS_WIN32_APP_USER_MODEL_ID="HypeProofLab.HypeProofStudio"
export HPS_WIN32_REG_VALUE_NAME="HypeProofStudio"

# --- VSCodium build flags -----------------------------------------------------
export VSCODE_QUALITY="stable"           # stable | insider
export CI_BUILD="no"                     # disable CI-only git config tweak
export OS_NAME="osx"                     # osx | linux | windows
export VSCODE_ARCH="arm64"               # arm64 | x64
export SHOULD_BUILD="yes"
export SHOULD_BUILD_REH="no"             # skip remote-extension-host build
export SHOULD_BUILD_REH_WEB="no"
export DISABLE_UPDATE="yes"              # no in-app updater for v0.1.0

# --- Build tuning -------------------------------------------------------------
export NODE_OPTIONS="--max-old-space-size=12288"
export VSCODE_PUBLISH_COUNTER=0          # skip sourcemap upload attempts
# Set these in your local hypeproof-studio.env (gitignored):
#   export GITHUB_TOKEN=...                # set only if hitting GitHub rate limits
#   export ANTHROPIC_API_KEY=...           # Worker secret (also set via `wrangler secret put`)
#   export HPS_SIGNING_SECRET=...          # token-signing HMAC key (Worker secret)
#   export APPLE_DEVELOPER_ID=...          # Mac signing (Phase 6)

# --- Sanity print -------------------------------------------------------------
echo "hypeproof-studio.env loaded:"
echo "  APP_NAME       = $APP_NAME"
echo "  BINARY_NAME    = $BINARY_NAME"
echo "  BUNDLE_ID      = $HPS_DARWIN_BUNDLE_ID"
echo "  NODE_OPTIONS   = $NODE_OPTIONS"
